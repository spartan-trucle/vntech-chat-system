          "queue",
          "notif",
          "push",
          "clients"
        ],
        "note": "No route in Redis: the message waits in the device sync queue and the phone is woken through APNs or FCM."
      },
      {
        "id": "history-media",
        "label": "History and media",
        "focus": [
          "clients",
          "lb",
          "api",
          "store",
          "blob"
        ],
        "note": "Everything that is not real-time goes over HTTPS: paging history by cursor and moving media bytes straight to object storage."
      }
    ]
